# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 GitHub에 올리지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다. (정지 방지 Cron, 탈퇴, 푸시 알림에서 사용)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Vercel Cron이 Authorization: Bearer 로 보내는 값. 아무 긴 임의 문자열.
CRON_SECRET=change-me

# 웹 푸시 알림 키. 만들기: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 공개 키는 브라우저가 쓰고, 비밀 키는 서버 전용이다 (NEXT_PUBLIC_ 을 붙이지 않는다).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
